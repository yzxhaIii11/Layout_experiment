<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android 布局实验目录"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_linear"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="实验一：线性布局 (LinearLayout)"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_table"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="实验二：表格布局 (TableLayout)"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_constraint1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="实验三：约束布局 1 (ConstraintLayout)"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_constraint2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="实验四：约束布局 2 (ConstraintLayout)"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_compose"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="实验五：Jetpack Compose 实验"
        android:textSize="16sp" />

</LinearLayout>